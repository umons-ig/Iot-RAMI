# ─── MQTT (Mosquitto local) ───────────────────────────────────────────────────
# En clair par défaut. Pour passer en TLS (recommandé dès que le LAN n'est pas
# de confiance) : `mqtts://<hote>` et port 8883 — mqtt.js gère le schéma seul.
# Le broker doit alors exposer un listener 8883, et les ESP être flashés avec
# l'environnement `universal_tls` (cf. docs/FIRMWARE_DEPLOYMENT.md).
MQTT_URL=mqtt://localhost
MQTT_PORT=1883
MQTT_USERNAME=fog1
MQTT_PASSWORD=change-me

# ─── Console de gestion des ESP (port 9200) ───────────────────────────────────
# OBLIGATOIRE : définissez MGMT_TOKEN ou MGMT_PASSWORD (ou les deux). Sans l'un
# des deux, l'API /api/* REFUSE toutes les requêtes (fail-closed) et le service
# le signale au démarrage. Cette API pilote l'OTA, le WiFi et le redémarrage de
# TOUTE la flotte : elle ne doit jamais être ouverte sans authentification.
#   MGMT_TOKEN    : secret statique, pour les scripts (en-tête X-Mgmt-Token).
#   MGMT_PASSWORD : mot de passe admin de la console web (login -> jeton de
#                   session signé, valable 12 h).
# MGMT_TOKEN=
# MGMT_PASSWORD=
#
# Adresse d'écoute de la console. Par défaut la loopback du Pi : on y accède par
# tunnel SSH (`ssh -L 9200:localhost:9200 pi@<pi>`). Mettre 0.0.0.0 pour un accès
# depuis le LAN — dans ce cas MGMT_TOKEN devient indispensable.
# MGMT_BIND=127.0.0.1
#
# Adresse de PUBLICATION des métriques Prometheus (côté hôte, cf. compose.yaml).
# Loopback par défaut : exposées à tout le réseau, elles livrent sans
# authentification l'activité des capteurs. Pour un scrape distant, passer par
# WireGuard et indiquer ici l'IP du tunnel plutôt que 0.0.0.0.
# METRICS_BIND=127.0.0.1

# ─── OTA firmware ─────────────────────────────────────────────────────────────
# Les URL d'OTA doivent être en HTTPS : en clair, un attaquant sur le chemin
# réseau substitue le binaire et fait exécuter un firmware arbitraire sur les
# capteurs. Ce garde-fou ne se lève que pour un banc de test, et il faut alors
# AUSSI compiler le firmware avec -D RAMI_ALLOW_INSECURE_OTA.
# ALLOW_INSECURE_OTA=true

# ─── Kafka (backend cloud) ────────────────────────────────────────────────────
# Format : host:port  (ex: monserveur.com:9092)
KAFKA_BROKERS=localhost:9092

# ─── Sécurité Kafka (optionnel — défaut: PLAINTEXT pour subnet local de confiance) ───
# Sur un réseau non fiable, préférer un tunnel WireGuard (niveau réseau) ; sinon activer SASL_SSL :
# KAFKA_SSL=true
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# ─── Buffer fog → Kafka ───────────────────────────────────────────────────────
# Intervalle de flush en ms (défaut 200ms — réduit la latence end-to-end)
FLUSH_INTERVAL_MS=200
# Taille max du buffer avant flush forcé (défaut 50 mesures)
FLUSH_MAX_SIZE=50
# Limite dure du buffer en mémoire par topic — au-delà, les mesures sont droppées
# jusqu'au prochain flush (défaut 500)
MAX_BUFFER_SIZE=500
# Durée max d'une session avant rotation automatique (stop + start), en ms (défaut 3600000 = 1h)
SESSION_MAX_DURATION_MS=3600000

# ─── Outbox store-and-forward (Postgres local) ────────────────────────────────
# Le fog persiste chaque mesure/événement dans une outbox Postgres locale (durable)
# avant de la répliquer vers Kafka. Aucune perte si Kafka tombe ; reprise au reboot.
# En conteneur, PG_HOST=postgres (nom du service compose) ; en dev local: localhost.
PG_HOST=localhost
PG_PORT=5432
PG_USER=fog
PG_PASSWORD=fog
PG_DATABASE=fog_outbox

# Intervalle entre deux tentatives de réplication outbox → Kafka (ms, défaut 500)
OUTBOX_REPLICATOR_INTERVAL_MS=500
# Nombre max de lignes pending lues/publiées par tick (défaut 200)
OUTBOX_BATCH_SIZE=200
# Durée de conservation des lignes synced avant purge (jours, défaut 7)
OUTBOX_RETENTION_DAYS=7
# Intervalle entre deux purges des lignes synced (ms, défaut 3600000 = 1h)
OUTBOX_PURGE_INTERVAL_MS=3600000
