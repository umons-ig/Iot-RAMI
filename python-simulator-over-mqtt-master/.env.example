# Credentials des brokers MQTT du simulateur.
# Copier ce fichier en `.env` (git-ignoré) et renseigner les vraies valeurs.
# Le simulateur charge automatiquement `.env` si python-dotenv est installé.
#
# ⚠️ Ne JAMAIS committer de credentials réels. Si d'anciens secrets ont fuité dans
#    l'historique git, les révoquer/changer côté broker.

# ─── Broker local (fog Mosquitto) ─────────────────────────────────────────────
LOCAL_MQTT_URL=10.0.0.252
LOCAL_MQTT_PORT=1883
LOCAL_MQTT_USERNAME=
LOCAL_MQTT_PASSWORD=

# ─── HiveMQ Cloud ─────────────────────────────────────────────────────────────
HIVEMQ_URL=
HIVEMQ_PORT=8883
HIVEMQ_WS_PORT=8884
HIVEMQ_USERNAME=
HIVEMQ_PASSWORD=

# ─── HiveMQ Cloud (instance secondaire) ───────────────────────────────────────
MARTIN_HIVEMQ_URL=
MARTIN_HIVEMQ_PORT=8883
MARTIN_HIVEMQ_USERNAME=
MARTIN_HIVEMQ_PASSWORD=
