# IP ou domaine public du serveur cloud
SERVER_HOST=10.0.0.152

# Base de données
DB_USER=umons-sensor-prod
DB_PASSWORD=change_me
DB_NAME=umons-sensor-db-prod

# JWT (générer avec : openssl rand -base64 64)
JWT_SECRET=change_me
REFRESH_TOKEN_SECRET=change_me

# Grafana
GF_SECURITY_ADMIN_PASSWORD=change_me

# ─── Sécurité Kafka (optionnel) ───────────────────────────────────────────────
# Défaut = PLAINTEXT, adapté à un subnet local de confiance (fog et cloud sur le
# même réseau privé). Sur un réseau non fiable, l'option recommandée est un tunnel
# WireGuard au niveau réseau (voir docs/ETAT_DES_LIEUX.md). Alternative applicative :
# activer SASL_SSL ci-dessous ET le listener broker correspondant dans docker-compose.yml.
# KAFKA_SSL=true
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

